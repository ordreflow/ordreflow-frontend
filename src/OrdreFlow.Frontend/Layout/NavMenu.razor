@implements IDisposable
@inject AuthState AuthState

<div class="header-inner">
    <button type="button"
            class="menu-toggle"
            title="Menu"
            aria-label="Menu"
            aria-expanded="@(collapseNavMenu ? "false" : "true")"
            @onclick="ToggleNavMenu">
        <span></span><span></span><span></span>
    </button>

    <a class="brand" href="">OrdreFlow</a>

    <nav class="nav-links @NavMenuCssClass" @onclick="CloseNavMenu">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Forside</NavLink>
        <NavLink class="nav-link" href="register-time">Registrer tid</NavLink>
        <NavLink class="nav-link" href="time-entries" Match="NavLinkMatch.All">Tidsregistreringer</NavLink>
        @if (AuthState.User is { Role: "Admin" or "Manager", Status: "Active" })
        {
            <NavLink class="nav-link" href="time-entries/review">Godkend tid</NavLink>
            <NavLink class="nav-link" href="orders">Ordrer</NavLink>
            <NavLink class="nav-link" href="reports/top-orders">Rapporter</NavLink>
        }
        @if (AuthState.User?.Role is "Admin" or "Manager")
        {
            <NavLink class="nav-link" href="users">Brugere</NavLink>
        }
        @if (AuthState.User is not null)
        {
            <span class="nav-user">@AuthState.User.Name</span>
        }
        <button type="button" class="nav-logout" @onclick="SignOut">Log ud</button>
    </nav>

    <a class="brand-logo" href="" aria-label="OrdreFlow forside">OF</a>
</div>

@code {
    private bool collapseNavMenu = true;

    // The profile name arrives after the session is restored from storage, so redraw when it changes.
    protected override void OnInitialized() => AuthState.Changed += OnAuthChanged;

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthState.Changed -= OnAuthChanged;

    private string? NavMenuCssClass => collapseNavMenu ? "collapsed" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
    }

    // MainLayout redirects to the login page when the session ends.
    private async Task SignOut() => await AuthState.SignOutAsync();
}
