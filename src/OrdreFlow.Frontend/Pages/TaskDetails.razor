@page "/work-items/{Id:guid}"
@page "/tasks/{Id:guid}"
@inject WorkItemsApiClient WorkItemsApi

<PageTitle>Arbejdsopgave | OrdreFlow</PageTitle>

<section class="of-card">
    <div class="of-card-header">
        <a class="of-back-btn" href="/work-items" aria-label="Tilbage til arbejdsopgaver">
            <span aria-hidden="true"><NavIcon Name="chevron-left" /></span>
        </a>
        <h1>Arbejdsopgave</h1>
    </div>
    @if (isLoading)
    {
        <p role="status">Henter arbejdsopgave...</p>
    }
    else if (error is not null)
    {
        <p class="validation-message" role="alert">@error</p>
        <button class="btn btn-outline-primary" @onclick="LoadAsync">Prøv igen</button>
    }
    else if (work is not null)
    {
        <dl class="task-details">
            <dt>Afdeling</dt>
            <dd>@work.DepartmentName</dd>
            <dt>Kategori</dt>
            <dd>@work.CategoryName</dd>
            <dt>Navn</dt>
            <dd class="task-details-title">@work.Name</dd>
            <dt>Type</dt>
            <dd>@work.Kind</dd>
            <dt>Beskrivelse</dt>
            <dd class="task-details-description">
                @(string.IsNullOrWhiteSpace(work.Description) ? "Ingen beskrivelse" : work.Description)
            </dd>
            @if (work.AssignmentOnly)
            {
                <dt>Tildeling</dt>
                <dd>@(work.AssignedToMe ? "Tildelt dig" : "Kun synlig for tildelte medarbejdere")</dd>
            }
        </dl>
    }
</section>

@code {
    [Parameter] public Guid Id { get; set; }

    private AccessibleWorkResponse? work;
    private bool isLoading = true;
    private string? error;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        work = null;
        var result = await WorkItemsApi.GetAsync(Id);
        if (result.IsSuccess)
            work = result.Value;
        else
            error = string.Join(" ", result.Errors.Select(item => item.Message));
        isLoading = false;
    }
}
