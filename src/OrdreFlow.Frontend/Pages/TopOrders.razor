@page "/reports/top-categories"
@page "/reports/top-orders"
@implements IAsyncDisposable
@using System.Globalization
@inject ReportsApiClient ReportsApi
@inject AuthState AuthState
@inject IJSRuntime JS

<PageTitle>Top 10 kategorier | OrdreFlow</PageTitle>

<section class="report-page">
    <header class="report-header">
        <p class="eyebrow">Rapporter</p>
        <h1>Top 10 kategorier</h1>
        <p class="muted">Kategorier med flest godkendte timer i den valgte periode.</p>
    </header>

    @if (!AuthState.CanViewReports)
    {
        <p class="alert alert-info">Rapporten kræver tilladelsen Afdelingsleder eller Administrator.</p>
    }
    else
    {
        <form class="report-toolbar" @onsubmit="LoadAsync" @onsubmit:preventDefault>
            <div>
                <label for="from-date">Fra</label>
                <input id="from-date" type="date" class="form-control" @bind="fromDate" />
            </div>
            <div>
                <label for="to-date">Til</label>
                <input id="to-date" type="date" class="form-control" @bind="toDate" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@isLoading">Vis rapport</button>
        </form>

        @if (validationError is not null)
        {
            <p class="alert alert-warning" role="alert">@validationError</p>
        }
        @if (isLoading)
        {
            <p role="status">Henter rapport...</p>
        }
        else if (loadError is not null)
        {
            <p class="alert alert-danger" role="alert">@loadError</p>
            <button class="btn btn-outline-danger" @onclick="LoadAsync">Prøv igen</button>
        }
        else if (items is not null)
        {
            @if (items.Count == 0)
            {
                <p class="empty-state">Ingen godkendte timer i perioden.</p>
            }
            else
            {
                <p class="muted">
                    @reportFrom.ToString("d. MMM yyyy", Culture)–@reportTo.ToString("d. MMM yyyy", Culture)
                    · @items.Count kategorier · @FormatHours(items.Sum(item => item.TotalHours)) timer
                </p>
                <div class="chart-card"><div class="chart-host" @ref="chartHost"></div></div>
                @if (selectedCategory is not null)
                {
                    <section class="report-table-section">
                        <h2>@selectedCategory.CategoryName <small class="muted">· @selectedCategory.DepartmentName</small></h2>
                        <p class="muted">Arbejdsopgavefordeling · @FormatHours(selectedCategory.TotalHours) timer</p>
                        <table class="report-table">
                            <thead><tr><th>Arbejdsopgave</th><th class="num">Timer</th><th class="num">Andel</th></tr></thead>
                            <tbody>
                                @foreach (var task in selectedCategory.Tasks)
                                {
                                    <tr>
                                        <td>@task.TaskName</td>
                                        <td class="num">@FormatHours(task.TotalHours)</td>
                                        <td class="num">@FormatHours(selectedCategory.TotalHours > 0 ? task.TotalHours / selectedCategory.TotalHours * 100 : 0)%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                }
            }
        }
    }
</section>

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("da-DK");
    private DateOnly fromDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly toDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly reportFrom;
    private DateOnly reportTo;
    private IReadOnlyList<TopCategoryResponse>? items;
    private TopCategoryResponse? selectedCategory;
    private bool isLoading;
    private bool renderPending;
    private string? loadError;
    private string? validationError;
    private ElementReference chartHost;
    private IJSObjectReference? chartModule;
    private DotNetObjectReference<TopOrders>? dotNetReference;

    protected override Task OnInitializedAsync() => AuthState.CanViewReports ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        validationError = null;
        if (toDate < fromDate)
        {
            validationError = "Slutdatoen skal være samme dag eller efter startdatoen.";
            return;
        }
        isLoading = true;
        loadError = null;
        selectedCategory = null;
        var result = await ReportsApi.GetTopCategoriesAsync(fromDate, toDate);
        if (result.IsSuccess)
        {
            items = result.Value!.Items;
            reportFrom = fromDate;
            reportTo = toDate;
            renderPending = true;
        }
        else
        {
            items = null;
            renderPending = false;
            loadError = string.Join(" ", result.Errors.Select(item => item.Message));
        }
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!renderPending || items is not { Count: > 0 }) return;
        renderPending = false;
        chartModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/top-orders-chart.js");
        dotNetReference ??= DotNetObjectReference.Create(this);
        await chartModule.InvokeVoidAsync("render", chartHost, items, dotNetReference);
    }

    [JSInvokable]
    public Task SelectCategory(string categoryId)
    {
        if (Guid.TryParse(categoryId, out var id))
            selectedCategory = items?.FirstOrDefault(item => item.CategoryId == id);
        return InvokeAsync(StateHasChanged);
    }

    private static string FormatHours(decimal hours) => hours.ToString("0.##", Culture);

    public async ValueTask DisposeAsync()
    {
        dotNetReference?.Dispose();
        if (chartModule is not null)
            await chartModule.DisposeAsync();
    }
}
