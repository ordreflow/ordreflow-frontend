@page "/time-entries"
@inject SavedTimeEntriesState SavedTimeEntriesState

<PageTitle>OrdreFlow</PageTitle>

<h1>Your time entries</h1>

@if (SavedTimeEntriesState.Entries.Count == 0)
{
    <p>No time registrations yet. <a href="/">Go register some time</a>.</p>
}
else
{
    <p class="weekly-total">
        This week's total: <strong>@WeeklyTotal.ToString("0.##") hours</strong>
    </p>

    <ul class="order-list">
        @foreach (var saved in SavedTimeEntriesState.Entries.OrderByDescending(e => e.Entry.Date))
        {
            <li class="order-card">
                <span class="order-card-name">@saved.Order.Name (@saved.Order.Customer)</span>
                <span class="order-card-customer">@saved.Entry.Date.ToString("ddd d MMM") &middot; @saved.Entry.Hours.ToString("0.##") hours</span>
                @if (!string.IsNullOrWhiteSpace(saved.Entry.Comment))
                {
                    <span class="order-card-customer">@saved.Entry.Comment</span>
                }
            </li>
        }
    </ul>
}

@code {
    private decimal WeeklyTotal => SavedTimeEntriesState.WeeklyTotalHours(DateTime.Today);
}
