@page "/time-entries"
@using System.Globalization
@inject ITimeEntriesApiClient TimeEntriesApi
@inject WorkItemsApiClient WorkItemsApi

<PageTitle>Mine registreringer | OrdreFlow</PageTitle>

<section class="time-entries">
    <h1>Mine registreringer</h1>
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-outline-primary" @onclick="() => ChangeWeek(-1)" aria-label="Forrige uge">‹</button>
        <span>Uge @ISOWeek.GetWeekOfYear(weekStart) (@weekStart.ToString("d/M") – @weekStart.AddDays(6).ToString("d/M"))</span>
        <button type="button" class="btn btn-outline-primary" @onclick="() => ChangeWeek(1)" aria-label="Næste uge">›</button>
    </div>

    @if (catalogError is not null)
    {
        <p class="alert alert-warning" role="alert">Arbejdsopgavenavne kunne ikke hentes: @catalogError</p>
    }
    @if (isLoading)
    {
        <p role="status">Henter tidsregistreringer...</p>
    }
    else if (error is not null)
    {
        <p class="validation-message" role="alert">@error</p>
        <button class="btn btn-outline-primary" @onclick="LoadWeekAsync">Prøv igen</button>
    }
    else if (entries.Count == 0)
    {
        <p>Ingen tidsregistreringer denne uge. <a href="/register-time">Registrer tid</a>.</p>
    }
    else
    {
        <p class="weekly-total">
            Ugens total: <strong>@FormatHours(entries.Sum(item => item.Hours)) timer</strong>
        </p>
        <ul class="order-list">
            @foreach (var entry in entries.OrderByDescending(item => item.Date))
            {
                <li class="order-card entry-card" @key="entry.Id">
                    <strong class="order-card-name">@WorkName(entry.TaskId)</strong>
                    <span class="order-card-customer">@entry.Date.ToString("d/M") · @FormatHours(entry.Hours) timer</span>
                    <span class="entry-status">Status: @StatusLabel(entry.Status)</span>
                    @if (entry.Status == "Rejected" && !string.IsNullOrWhiteSpace(entry.RejectionReason))
                    {
                        <p class="alert alert-warning mt-2">Begrundelse: @entry.RejectionReason</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.Comment))
                    {
                        <span class="order-card-customer entry-comment">@entry.Comment</span>
                    }
                    <div class="entry-actions">
                        <button class="btn btn-outline-secondary" type="button"
                                aria-expanded="@IsExpanded(entry.Id)"
                                @onclick="() => ToggleReviewsAsync(entry.Id)">
                            @(IsExpanded(entry.Id) ? "Skjul vurderinger" : "Vis vurderinger")
                        </button>
                        @if (entry.Status is "Draft" or "Rejected")
                        {
                            <a class="btn btn-outline-primary" href="@($"/register-time/{entry.Id:D}")">Rediger</a>
                        }
                    </div>
                    @if (IsExpanded(entry.Id))
                    {
                        var state = reviewStates[entry.Id];
                        @if (state.IsLoading)
                        {
                            <p role="status">Henter vurderinger...</p>
                        }
                        else if (state.Error is not null)
                        {
                            <p class="validation-message" role="alert">@state.Error</p>
                            <button class="btn btn-outline-primary" @onclick="() => LoadReviewsAsync(entry.Id, state)">Prøv igen</button>
                        }
                        else if (state.Items.Count == 0)
                        {
                            <p class="muted">Ingen vurderinger endnu.</p>
                        }
                        else
                        {
                            <ul class="review-list">
                                @foreach (var review in state.Items)
                                {
                                    <li class="review-item" @key="review.Id">
                                        <strong>@StatusLabel(review.Decision)</strong>
                                        <time>@review.ReviewedAt.ToLocalTime().ToString("g", CultureInfo.GetCultureInfo("da-DK"))</time>
                                        @if (!string.IsNullOrWhiteSpace(review.Reason))
                                        {
                                            <span>@review.Reason</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    private DateTime weekStart = StartOfWeek(DateTime.Today);
    private IReadOnlyList<TimeEntryResponse> entries = [];
    private IReadOnlyList<AccessibleWorkResponse> workItems = [];
    private readonly Dictionary<Guid, ReviewState> reviewStates = [];
    private bool isLoading = true;
    private string? error;
    private string? catalogError;
    private int loadVersion;

    protected override async Task OnInitializedAsync()
    {
        var catalog = await WorkItemsApi.GetAccessibleAsync();
        if (catalog.IsSuccess)
            workItems = catalog.Value!.Items;
        else
            catalogError = string.Join(" ", catalog.Errors.Select(item => item.Message));
        await LoadWeekAsync();
    }

    private async Task ChangeWeek(int weeks)
    {
        weekStart = weekStart.AddDays(7 * weeks);
        await LoadWeekAsync();
    }

    private async Task LoadWeekAsync()
    {
        var version = ++loadVersion;
        isLoading = true;
        error = null;
        var result = await TimeEntriesApi.GetEntriesAsync(DateOnly.FromDateTime(weekStart), DateOnly.FromDateTime(weekStart.AddDays(6)));
        if (version != loadVersion) return;
        if (result.IsSuccess)
        {
            entries = result.Value!.Items.ToArray();
            reviewStates.Clear();
            foreach (var entry in entries)
                reviewStates[entry.Id] = new ReviewState();
        }
        else
        {
            entries = [];
            error = string.Join(" ", result.Errors.Select(item => item.Message));
        }
        isLoading = false;
    }

    private bool IsExpanded(Guid id) => reviewStates.TryGetValue(id, out var state) && state.IsExpanded;

    private async Task ToggleReviewsAsync(Guid id)
    {
        if (!reviewStates.TryGetValue(id, out var state)) return;
        state.IsExpanded = !state.IsExpanded;
        if (state.IsExpanded && !state.HasLoaded)
            await LoadReviewsAsync(id, state);
    }

    private async Task LoadReviewsAsync(Guid id, ReviewState state)
    {
        if (state.IsLoading) return;
        state.IsLoading = true;
        state.Error = null;
        var result = await TimeEntriesApi.GetReviewsAsync(id);
        if (!reviewStates.TryGetValue(id, out var current) || !ReferenceEquals(current, state)) return;
        state.IsLoading = false;
        if (result.IsSuccess)
        {
            state.Items = result.Value!.Items.ToArray();
            state.HasLoaded = true;
        }
        else
            state.Error = string.Join(" ", result.Errors.Select(item => item.Message));
    }

    private string WorkName(Guid id) =>
        workItems.FirstOrDefault(item => item.Id == id) is { } work
            ? $"{work.Name} · {work.CategoryName}"
            : "Arbejdsopgave ikke længere tilgængelig";

    private static string StatusLabel(string status) => status switch
    {
        "Draft" => "Kladde",
        "ReadyForApproval" => "Afventer review",
        "Approved" => "Godkendt",
        "Rejected" => "Returneret",
        "Closed" => "Afsluttet",
        _ => status
    };

    private static DateTime StartOfWeek(DateTime date) => date.Date.AddDays(-(((int)date.DayOfWeek + 6) % 7));
    private static string FormatHours(decimal hours) => hours.ToString("0.##", CultureInfo.InvariantCulture).Replace('.', ',');

    private sealed class ReviewState
    {
        public bool IsExpanded { get; set; }
        public bool IsLoading { get; set; }
        public bool HasLoaded { get; set; }
        public string? Error { get; set; }
        public IReadOnlyList<TimeEntryReviewResponse> Items { get; set; } = [];
    }
}
