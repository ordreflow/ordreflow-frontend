@page "/"
@inject IOrdersProvider OrdersProvider
@inject SelectedOrderState SelectedOrderState
@using OrdreFlow.Frontend.Models
@using OrdreFlow.Frontend.Services

<PageTitle>OrdreFlow</PageTitle>

<h1>Select an order</h1>
<p>Choose the order or case you want to register time on.</p>

@if (orders is null)
{
    <p>Loading orders...</p>
}
else if (orders.Count == 0)
{
    <p>No orders available.</p>
}
else
{
    <ul class="order-list">
        @foreach (var order in orders)
        {
            <li>
                <button type="button"
                        class="order-card @(SelectedOrderState.SelectedOrder?.Id == order.Id ? "order-card-selected" : "")"
                        @onclick="() => Select(order)">
                    <span class="order-card-name">@order.Name</span>
                    <span class="order-card-customer">@order.Customer</span>
                </button>
            </li>
        }
    </ul>
}

@if (SelectedOrderState.SelectedOrder is not null)
{
    <p class="order-selection-summary">
        Selected: <strong>@SelectedOrderState.SelectedOrder.Name</strong>
    </p>
}

@code {
    private IReadOnlyList<Order>? orders;

    protected override async Task OnInitializedAsync()
    {
        orders = await OrdersProvider.GetOrdersAsync();
    }

    private void Select(Order order) => SelectedOrderState.Select(order);
}
