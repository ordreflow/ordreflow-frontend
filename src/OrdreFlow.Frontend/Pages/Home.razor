@page "/"
@using System.Globalization
@inject SavedTimeEntriesState SavedTimeEntriesState
@inject NavigationManager Navigation

<PageTitle>OrdreFlow</PageTitle>

<div class="dashboard">
    <section class="dashboard-main">
        <div class="greeting">
            <h1>Hej @UserName</h1>
            <p>Her er dit overblik for ugen.</p>
        </div>

        <div class="week-card">
            <div class="week-nav">
                <button type="button" class="week-nav-btn" aria-label="Forrige uge" @onclick="() => ChangeWeek(-1)">
                    <span aria-hidden="true">&lsaquo;</span>
                </button>
                <div class="week-label">
                    <span class="week-number">Uge @ISOWeek.GetWeekOfYear(weekStart)</span>
                    <span class="week-range">@FormatShortDate(weekStart) &ndash; @FormatShortDate(weekStart.AddDays(6))</span>
                </div>
                <button type="button" class="week-nav-btn" aria-label="Næste uge" @onclick="() => ChangeWeek(1)">
                    <span aria-hidden="true">&rsaquo;</span>
                </button>
            </div>

            <div class="day-strip">
                @for (var i = 0; i < 7; i++)
                {
                    var day = weekStart.AddDays(i);
                    var hours = HoursOn(day);
                    var isSelected = selectedDay == day;
                    var isToday = day == DateTime.Today;

                    <button type="button"
                            class="day @(isSelected ? "day-selected" : "") @(isToday ? "day-today" : "")"
                            aria-pressed="@(isSelected ? "true" : "false")"
                            aria-label="@DayNames[i] @FormatShortDate(day)"
                            @onclick="() => ToggleDay(day)">
                        <span class="day-date">@FormatShortDate(day)</span>
                        <span class="day-letter">@DayNames[i][0]</span>
                        <span class="day-marker">
                            @if (hours > 0)
                            {
                                <span class="day-dot" aria-hidden="true"></span>
                                <span class="day-hours">@FormatHours(hours) t</span>
                            }
                        </span>
                    </button>
                }
            </div>

            @if (selectedDay is DateTime selected)
            {
                var entries = EntriesOn(selected);

                <div class="day-panel">
                    <h2 class="day-panel-title">
                        @DayNames[DayIndex(selected)] @FormatShortDate(selected)
                        <span class="day-panel-total">@FormatHours(HoursOn(selected)) timer</span>
                    </h2>

                    @if (entries.Count == 0)
                    {
                        <p class="day-panel-empty">Ingen registreringer denne dag.</p>
                    }
                    else
                    {
                        <ul class="entry-list">
                            @foreach (var saved in entries)
                            {
                                var isExpanded = expandedEntryIds.Contains(saved.Entry.Id);

                                <li class="entry">
                                    <div class="entry-row">
                                        <div class="entry-col">
                                            <span class="entry-label">Opgave</span>
                                            <span class="entry-value">@saved.Order.Name</span>
                                        </div>
                                        <div class="entry-col">
                                            <span class="entry-label">Kunde</span>
                                            <span class="entry-value">@saved.Order.Customer</span>
                                        </div>
                                        <span class="entry-hours">@FormatHours(saved.Entry.Hours) t</span>
                                        <button type="button"
                                                class="entry-details-btn"
                                                aria-expanded="@(isExpanded ? "true" : "false")"
                                                @onclick="() => ToggleDetails(saved.Entry.Id)">
                                            Detaljer
                                        </button>
                                    </div>

                                    @if (isExpanded)
                                    {
                                        <dl class="entry-details">
                                            <dt>Timer</dt>
                                            <dd>@FormatHours(saved.Entry.Hours)</dd>
                                            <dt>Kommentar</dt>
                                            <dd>@(string.IsNullOrWhiteSpace(saved.Entry.Comment) ? "Ingen kommentar" : saved.Entry.Comment)</dd>
                                        </dl>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    </section>

    <aside class="dashboard-side">
        <div class="total-card">
            <span class="total-label">Total denne uge</span>
            <span class="total-value">@FormatHours(WeekTotal) <small>timer</small></span>
        </div>

        <div class="register-bar">
            <button type="button" class="btn btn-primary register-btn" @onclick="RegisterNewTime">
                Registrer ny tid
            </button>
        </div>
    </aside>
</div>

@code {
    // No login yet, so there is no real user name. Replace with the authenticated user once auth exists.
    private const string UserName = "Baris";

    private static readonly string[] DayNames =
        ["Mandag", "Tirsdag", "Onsdag", "Torsdag", "Fredag", "Lørdag", "Søndag"];

    private DateTime weekStart = StartOfWeek(DateTime.Today);
    private DateTime? selectedDay;
    private readonly HashSet<int> expandedEntryIds = [];

    private decimal WeekTotal => SavedTimeEntriesState.WeeklyTotalHours(weekStart);

    private void ChangeWeek(int weeks)
    {
        weekStart = weekStart.AddDays(7 * weeks);
        selectedDay = null;
    }

    private void ToggleDay(DateTime day) => selectedDay = selectedDay == day ? null : day;

    private void ToggleDetails(int entryId)
    {
        if (!expandedEntryIds.Remove(entryId))
        {
            expandedEntryIds.Add(entryId);
        }
    }

    private List<SavedTimeEntry> EntriesOn(DateTime day) =>
        SavedTimeEntriesState.Entries.Where(e => e.Entry.Date.Date == day).ToList();

    private decimal HoursOn(DateTime day) =>
        SavedTimeEntriesState.Entries.Where(e => e.Entry.Date.Date == day).Sum(e => e.Entry.Hours);

    private void RegisterNewTime() => Navigation.NavigateTo("/select-order");

    private static int DayIndex(DateTime date) => ((int)date.DayOfWeek + 6) % 7;

    private static DateTime StartOfWeek(DateTime date) => date.Date.AddDays(-DayIndex(date));

    private static string FormatShortDate(DateTime date) => $"{date.Day}/{date.Month}";

    // Danish decimal comma without depending on da-DK culture data being loaded in WebAssembly.
    private static string FormatHours(decimal hours) =>
        hours.ToString("0.##", CultureInfo.InvariantCulture).Replace('.', ',');
}
