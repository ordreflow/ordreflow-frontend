@page "/time-entries/export"
@using System.Text
@implements IAsyncDisposable
@inject ITimeEntriesApiClient TimeEntriesApiClient
@inject UsersApiClient UsersApiClient
@inject AuthState AuthState
@inject IJSRuntime JS

<PageTitle>Eksporter tid | OrdreFlow</PageTitle>

<section class="export-page">
    <header class="export-header">
        <p class="eyebrow">Tidsregistreringer</p>
        <h1>Eksporter tid</h1>
        <p class="muted">Download godkendte tidsregistreringer for en periode som en CSV-fil, der kan åbnes i fx Excel.</p>
    </header>

    @if (!CanExport)
    {
        <p class="alert alert-info">Eksport af tid er kun tilgængelig for aktive managere og administratorer.</p>
    }
    else
    {
        <div class="export-card">
            <div class="presets" role="group" aria-label="Hurtigvalg af periode">
                <button type="button" class="btn btn-outline-secondary" disabled="@isExporting" @onclick="ThisMonth">Denne måned</button>
                <button type="button" class="btn btn-outline-secondary" disabled="@isExporting" @onclick="LastMonth">Sidste måned</button>
            </div>

            <div class="period">
                <div>
                    <label for="export-from">Fra</label>
                    <input id="export-from" type="date" class="form-control" disabled="@isExporting" @bind="fromDate" />
                </div>
                <div>
                    <label for="export-to">Til</label>
                    <input id="export-to" type="date" class="form-control" disabled="@isExporting" @bind="toDate" />
                </div>
            </div>

            @if (!IsValidPeriod)
            {
                <p class="validation-message" role="alert">Til-datoen skal være samme dag som eller efter fra-datoen.</p>
            }

            <div class="employee-picker">
                <label for="employee-search">Medarbejder</label>
                <input id="employee-search" type="search" class="form-control" placeholder="Søg efter navn eller e-mail..."
                       disabled="@isExporting" @bind="employeeSearch" @bind:event="oninput" @bind:after="KeepSelectionVisible" />
                <select id="employee-filter" class="form-select" aria-label="Vælg medarbejder"
                        disabled="@isExporting" @bind="selectedEmployeeId">
                    <option value="">Alle medarbejdere</option>
                    @foreach (var employee in VisibleEmployees)
                    {
                        <option value="@employee.Id">@employee.Name</option>
                    }
                </select>
                @if (employeesError is not null)
                {
                    <p class="muted mb-0">Medarbejderlisten kunne ikke hentes, men du kan stadig eksportere for alle. @employeesError</p>
                }
                else if (employeeSearch.Length > 0 && !VisibleEmployees.Any())
                {
                    <p class="muted mb-0">Ingen medarbejdere matcher søgningen.</p>
                }
            </div>

            <p class="muted">
                Filen indeholder godkendte og afsluttede registreringer for
                @(SelectedEmployee?.Name ?? (AuthState.User?.Role == "Admin" ? "alle medarbejdere" : "alle dine medarbejdere")).
            </p>

            <button type="button" class="btn btn-primary export-btn" disabled="@(isExporting || !IsValidPeriod)" @onclick="ExportAsync">
                @(isExporting ? "Henter fil..." : "Download CSV")
            </button>

            @if (error is not null)
            {
                <p class="alert alert-danger mt-3 mb-0" role="alert">@error</p>
            }
            @if (notice is not null)
            {
                <p class="alert alert-info mt-3 mb-0" role="status">@notice</p>
            }
        </div>
    }
</section>

@code {
    private DateOnly fromDate;
    private DateOnly toDate;
    private bool isExporting;
    private string? error;
    private string? notice;
    private IJSObjectReference? downloadModule;
    private IReadOnlyList<UserResponse> employees = [];
    private string? employeesError;
    private string employeeSearch = "";
    private string selectedEmployeeId = "";

    // Same rule as the backend's ManagerOrAdmin policy.
    private bool CanExport => AuthState.User is { Role: "Manager" or "Admin", Status: "Active" };

    private bool IsValidPeriod => toDate >= fromDate;

    private UserResponse? SelectedEmployee =>
        employees.FirstOrDefault(employee => employee.Id.ToString() == selectedEmployeeId);

    private IEnumerable<UserResponse> VisibleEmployees => employees.Where(employee =>
        employee == SelectedEmployee ||
        employee.Name.Contains(employeeSearch, StringComparison.OrdinalIgnoreCase) ||
        employee.Email.Contains(employeeSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        ThisMonth();
        if (CanExport)
        {
            await LoadEmployeesAsync();
        }
    }

    // Managers pick among their own employees (the export is limited to them anyway); admins among everyone.
    private async Task LoadEmployeesAsync()
    {
        var result = await UsersApiClient.GetUsersAsync();
        if (!result.IsSuccess)
        {
            employeesError = string.Join(" ", result.Errors.Select(item => item.Message));
            return;
        }

        var me = AuthState.User!;
        employees = result.Value!.Items
            .Where(user => user.Id != me.Id && (me.Role == "Admin" || user.ManagerId == me.Id))
            .OrderBy(user => user.Name)
            .ToArray();
    }

    // When the search narrows the list to one person, select them so the dropdown matches what is shown.
    private void KeepSelectionVisible()
    {
        var matches = VisibleEmployees.ToArray();
        if (employeeSearch.Length > 0 && matches.Length == 1)
        {
            selectedEmployeeId = matches[0].Id.ToString();
        }
    }

    private void ThisMonth()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        fromDate = new DateOnly(today.Year, today.Month, 1);
        toDate = fromDate.AddMonths(1).AddDays(-1);
    }

    private void LastMonth()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        toDate = new DateOnly(today.Year, today.Month, 1).AddDays(-1);
        fromDate = new DateOnly(toDate.Year, toDate.Month, 1);
    }

    private async Task ExportAsync()
    {
        isExporting = true;
        error = notice = null;

        var result = await TimeEntriesApiClient.ExportAcceptedAsync(fromDate, toDate, SelectedEmployee?.Id);

        if (!result.IsSuccess)
        {
            error = string.Join(" ", result.Errors.Select(item => item.Message));
            isExporting = false;
            return;
        }

        var file = result.Value!;
        var rows = CountRows(file.Content);
        if (rows == 0)
        {
            notice = "Der er ingen godkendte tidsregistreringer i perioden, så der er ikke downloadet nogen fil.";
            isExporting = false;
            return;
        }

        downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download-file.js");
        await downloadModule.InvokeVoidAsync("downloadFile", file.FileName, file.ContentType, file.Content);
        notice = $"{file.FileName} er downloadet med {rows} {(rows == 1 ? "registrering" : "registreringer")}.";
        isExporting = false;
    }

    // Data lines after the header; quoted fields may contain line breaks, so count outside quotes only.
    private static int CountRows(byte[] content)
    {
        var lines = 0;
        var inQuotes = false;
        foreach (var character in Encoding.UTF8.GetString(content))
        {
            if (character == '"') inQuotes = !inQuotes;
            else if (character == '\n' && !inQuotes) lines++;
        }

        return Math.Max(0, lines - 1);
    }

    public async ValueTask DisposeAsync()
    {
        if (downloadModule is not null)
        {
            try
            {
                await downloadModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
