@page "/time-entries/export"
@using System.Text
@implements IAsyncDisposable
@inject ExportsApiClient ExportsApi
@inject AuthState AuthState
@inject IJSRuntime JS

<PageTitle>Eksporter tidsregistreringer | OrdreFlow</PageTitle>

<section class="export-page">
    <header class="export-header">
        <p class="eyebrow">Løn og eksport</p>
        <h1>Eksporter tid</h1>
        <p class="muted">Opret en eksportbatch og hent CSV-filen for en valgt periode.</p>
    </header>

    @if (!AuthState.CanExportTime)
    {
        <p class="alert alert-info">Eksport kræver tilladelsen Payroll eller Administrator.</p>
    }
    else
    {
        <div class="export-card">
            <div class="presets">
                <button class="btn btn-outline-secondary" disabled="@isExporting" @onclick="ThisMonth">Denne måned</button>
                <button class="btn btn-outline-secondary" disabled="@isExporting" @onclick="LastMonth">Sidste måned</button>
            </div>
            <div class="period">
                <div>
                    <label for="export-from">Fra</label>
                    <input id="export-from" type="date" class="form-control" disabled="@isExporting" @bind="fromDate" />
                </div>
                <div>
                    <label for="export-to">Til</label>
                    <input id="export-to" type="date" class="form-control" disabled="@isExporting" @bind="toDate" />
                </div>
            </div>
            <div class="employee-picker">
                <label for="employee-search">Medarbejder</label>
                <input id="employee-search" type="search" class="form-control" placeholder="Søg medarbejder..."
                       disabled="@isExporting" @bind="employeeSearch" @bind:event="oninput" @bind:after="LoadEmployeesAsync" />
                <select id="employee-filter" class="form-select mt-2" @bind="employeeId" disabled="@isExporting">
                    <option value="">Alle medarbejdere</option>
                    @foreach (var employee in employees)
                    {
                        <option value="@employee.Id">@employee.Name (@employee.Status)</option>
                    }
                </select>
                @if (employeeError is not null)
                {
                    <p class="text-danger" role="alert">@employeeError</p>
                }
            </div>
            @if (toDate < fromDate)
            {
                <p class="validation-message" role="alert">Til-datoen skal være samme dag eller efter fra-datoen.</p>
            }
            @if (error is not null)
            {
                <p class="alert alert-danger" role="alert">@error</p>
            }
            @if (notice is not null)
            {
                <p class="alert alert-info" role="status">@notice</p>
            }
            <button type="button" class="btn btn-primary export-btn"
                    disabled="@(isExporting || toDate < fromDate)" @onclick="ExportAsync">
                @(isExporting ? "Opretter eksport og henter fil..." : "Opret eksport og download CSV")
            </button>
        </div>

        <section class="mt-4">
            <h2 class="h4">Tidligere eksportbatcher</h2>
            @if (exportsError is not null)
            {
                <p class="alert alert-warning">@exportsError</p>
            }
            @foreach (var export in exports)
            {
                <p class="mb-1">
                    @export.FromDate.ToString("d/M/yyyy")–@export.ToDate.ToString("d/M/yyyy")
                    · @export.EntryCount registreringer · @export.TotalHours timer
                    · @(export.TimeEntriesClosedAtUtc is null ? "Ikke lukket" : "Lukket")
                </p>
            }
        </section>
    }
</section>

@code {
    private DateOnly fromDate;
    private DateOnly toDate;
    private string employeeSearch = "";
    private string employeeId = "";
    private IReadOnlyList<ExportEmployeeResponse> employees = [];
    private IReadOnlyList<ExportSummaryResponse> exports = [];
    private bool isExporting;
    private string? employeeError;
    private string? exportsError;
    private string? error;
    private string? notice;
    private IJSObjectReference? downloadModule;

    protected override async Task OnInitializedAsync()
    {
        ThisMonth();
        if (AuthState.CanExportTime)
        {
            await LoadEmployeesAsync();
            await LoadExportsAsync();
        }
    }

    private async Task LoadEmployeesAsync()
    {
        var result = await ExportsApi.GetEmployeesAsync(employeeSearch);
        if (result.IsSuccess)
        {
            employees = result.Value!.Items;
            employeeError = null;
        }
        else
        {
            employeeError = string.Join(" ", result.Errors.Select(item => item.Message));
        }
    }

    private async Task LoadExportsAsync()
    {
        var result = await ExportsApi.GetExportsAsync();
        if (result.IsSuccess) exports = result.Value!.Items;
        else exportsError = string.Join(" ", result.Errors.Select(item => item.Message));
    }

    private void ThisMonth()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        fromDate = new DateOnly(today.Year, today.Month, 1);
        toDate = fromDate.AddMonths(1).AddDays(-1);
    }

    private void LastMonth()
    {
        toDate = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1).AddDays(-1);
        fromDate = new DateOnly(toDate.Year, toDate.Month, 1);
    }

    private async Task ExportAsync()
    {
        isExporting = true;
        error = notice = null;
        var parsedEmployeeId = Guid.TryParse(employeeId, out var selected) ? selected : (Guid?)null;
        var result = await ExportsApi.CreateAndDownloadAsync(fromDate, toDate, parsedEmployeeId);
        if (!result.IsSuccess)
        {
            error = string.Join(" ", result.Errors.Select(item => item.Message));
            isExporting = false;
            return;
        }

        var file = result.Value!;
        var rows = CountRows(file.Content);
        if (rows == 0)
        {
            notice = "Eksportbatchen blev oprettet, men indeholder ingen registreringer.";
        }
        else
        {
            downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/download-file.js");
            await downloadModule.InvokeVoidAsync("downloadFile", file.FileName, file.ContentType, file.Content);
            notice = $"{file.FileName} er downloadet med {rows} registreringer.";
        }
        await LoadExportsAsync();
        isExporting = false;
    }

    private static int CountRows(byte[] content)
    {
        var lines = 0;
        var inQuotes = false;
        foreach (var character in Encoding.UTF8.GetString(content))
        {
            if (character == '"') inQuotes = !inQuotes;
            else if (character == '\n' && !inQuotes) lines++;
        }
        return Math.Max(0, lines - 1);
    }

    public async ValueTask DisposeAsync()
    {
        if (downloadModule is not null)
            await downloadModule.DisposeAsync();
    }
}
