@page "/register-time"
@page "/register-time/{EntryId:guid}"
@inject WorkItemsApiClient WorkItemsApi
@inject ITimeEntriesApiClient TimeEntriesApi
@inject TimeEntrySaveNotice SaveNotice
@inject NavigationManager Navigation

<PageTitle>@(IsEdit ? "Rediger registrering" : "Registrer tid") | OrdreFlow</PageTitle>

<div class="register-card">
    <div class="register-header">
        <a class="back-btn" href="/" aria-label="Tilbage til forsiden">
            <span aria-hidden="true"><NavIcon Name="chevron-left" /></span>
        </a>
        <h1>@(IsEdit ? "Rediger registrering" : "Registrer tid")</h1>
    </div>
    @if (isLoading)
    {
        <p role="status">Henter oplysninger...</p>
    }
    else if (loadError is not null)
    {
        <p class="validation-message" role="alert">@loadError</p>
        <button class="btn btn-outline-primary" @onclick="LoadAsync">Prøv igen</button>
    }
    else
    {
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            @if (IsEdit)
            {
                <div class="selected-task mb-3">
                    <strong>@(selectedWork?.Name ?? "Arbejdsopgave")</strong>
                    @if (selectedWork is not null)
                    {
                        <span class="d-block">@selectedWork.DepartmentName · @selectedWork.CategoryName</span>
                    }
                    else
                    {
                        <span class="d-block">Arbejdsopgavens detaljer er ikke længere tilgængelige.</span>
                    }
                </div>
            }
            else
            {
                @if (workItems.Count == 0)
                {
                    <p class="register-message">Der er ikke noget arbejde, du kan registrere tid på.</p>
                }
                else
                {
                    <div class="form-field">
                        <label for="category">Kategori</label>
                        <InputSelect id="category" class="form-select form-select-lg" @bind-Value="form.CategoryId"
                                     @bind-Value:after="CategoryChanged">
                            <option value="">Vælg kategori</option>
                            @foreach (var department in Categories.GroupBy(category => category.DepartmentName))
                            {
                                @if (HasSeveralDepartments)
                                {
                                    <optgroup label="@department.Key">
                                        @foreach (var category in department)
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </optgroup>
                                }
                                else
                                {
                                    @foreach (var category in department)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                }
                            }
                        </InputSelect>
                    </div>
                    <div class="form-field">
                        <label for="work-item">Opgave</label>
                        <InputSelect id="work-item" class="form-select form-select-lg" @bind-Value="form.WorkItemId"
                                     disabled="@(form.CategoryId is null)"
                                     aria-describedby="@(string.IsNullOrWhiteSpace(SelectedWorkItem?.Description) ? null : "work-item-hint")">
                            <option value="">@(form.CategoryId is null ? "Vælg først en kategori" : "Vælg opgave")</option>
                            @foreach (var work in WorkInCategory)
                            {
                                <option value="@work.Id">@work.Name@(work.AssignedToMe ? " · Tildelt dig" : "")</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => form.WorkItemId" />
                        @if (SelectedWorkItem is { } chosen && !string.IsNullOrWhiteSpace(chosen.Description))
                        {
                            <p id="work-item-hint" class="field-hint">@chosen.Description</p>
                        }
                    </div>
                }
            }

            <div class="form-section">
                <label for="hours" class="section-title">Timer</label>
                <InputNumber id="hours" class="form-control" step="0.25" min="0.25" max="24" @bind-Value="form.Hours" />
                <ValidationMessage For="() => form.Hours" />
                <div class="chip-row hours mt-2" aria-label="Vælg antal timer">
                    @foreach (var shortcut in HourShortcuts)
                    {
                        <button type="button" class="chip @(form.Hours == shortcut.Value ? "selected" : null)"
                                @onclick="() => form.Hours = shortcut.Value">@shortcut.Label</button>
                    }
                </div>
            </div>
            <div class="form-section">
                <label for="date" class="section-title">Dato</label>
                <InputDate id="date" class="form-control" @bind-Value="form.Date" />
                <ValidationMessage For="() => form.Date" />
                <div class="chip-row mt-2" aria-label="Vælg dato">
                    <button type="button" class="chip @(form.Date.Date == DateTime.Today ? "selected" : null)"
                            @onclick="() => form.Date = DateTime.Today">I dag</button>
                    <button type="button" class="chip @(form.Date.Date == DateTime.Today.AddDays(-1) ? "selected" : null)"
                            @onclick="() => form.Date = DateTime.Today.AddDays(-1)">I går</button>
                </div>
            </div>
            <div class="form-section">
                <label for="comment" class="section-title">Kommentar (valgfri)</label>
                <InputTextArea id="comment" class="form-control" rows="3" @bind-Value="form.Comment" />
                <ValidationMessage For="() => form.Comment" />
            </div>
            <fieldset class="appendices" disabled>
                <legend>Vedhæftning</legend>
                <input type="file" aria-label="Vedhæft fil" />
                <span>Vedhæftning er ikke tilgængelig endnu.</span>
            </fieldset>
            @if (submitError is not null)
            {
                <p class="validation-message" role="alert">@submitError</p>
            }
            <button type="submit" class="btn btn-primary" disabled="@(isSubmitting || (!IsEdit && workItems.Count == 0))">
                @(isSubmitting ? "Gemmer..." : IsEdit ? "Gem ændringer" : "Registrer tid")
            </button>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid? EntryId { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public DateTime? Date { get; set; }

    private static readonly (decimal Value, string Label)[] HourShortcuts =
    [
        (0.5m, "½"),
        (1m, "1"),
        (2m, "2"),
        (4m, "4"),
        (7.5m, "7,5")
    ];

    private TimeEntryForm form = new();
    private IReadOnlyList<AccessibleWorkResponse> workItems = [];
    private AccessibleWorkResponse? selectedWork;
    private Guid? currentTaskId;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? loadError;
    private string? submitError;

    private bool IsEdit => EntryId is not null;

    private sealed record CategoryOption(Guid Id, string Name, string DepartmentName);

    // Categories are derived from the work the employee may register on, so only usable categories are offered.
    private IReadOnlyList<CategoryOption> Categories => workItems
        .GroupBy(work => work.CategoryId)
        .Select(group => new CategoryOption(group.Key, group.First().CategoryName, group.First().DepartmentName))
        .OrderBy(category => category.DepartmentName, StringComparer.CurrentCultureIgnoreCase)
        .ThenBy(category => category.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();

    private bool HasSeveralDepartments => workItems.Select(work => work.DepartmentId).Distinct().Skip(1).Any();

    // Work assigned to the employee comes first.
    private IEnumerable<AccessibleWorkResponse> WorkInCategory => workItems
        .Where(work => work.CategoryId == form.CategoryId)
        .OrderByDescending(work => work.AssignedToMe)
        .ThenBy(work => work.Name, StringComparer.CurrentCultureIgnoreCase);

    private AccessibleWorkResponse? SelectedWorkItem => workItems.FirstOrDefault(work => work.Id == form.WorkItemId);

    private void CategoryChanged()
    {
        form.WorkItemId = null;
        SelectOnlyWorkItem();
    }

    // Spare the employee a click when there is only one choice.
    private void SelectOnlyCategory()
    {
        if (Categories is [var only])
        {
            form.CategoryId = only.Id;
            SelectOnlyWorkItem();
        }
    }

    private void SelectOnlyWorkItem()
    {
        if (WorkInCategory.ToArray() is [var only])
            form.WorkItemId = only.Id;
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = submitError = null;
        selectedWork = null;
        currentTaskId = null;
        form = new TimeEntryForm { Date = Date?.Date ?? DateTime.Today };

        if (IsEdit)
        {
            var entryResult = await TimeEntriesApi.GetAsync(EntryId!.Value);
            if (!entryResult.IsSuccess)
            {
                loadError = Errors(entryResult);
                isLoading = false;
                return;
            }

            var entry = entryResult.Value!;
            currentTaskId = entry.TaskId;
            form = new TimeEntryForm
            {
                WorkItemId = entry.TaskId,
                Date = entry.Date,
                Hours = entry.Hours,
                Comment = entry.Comment
            };
            var workResult = await WorkItemsApi.GetAsync(entry.TaskId);
            if (workResult.IsSuccess)
                selectedWork = workResult.Value;
        }
        else
        {
            var result = await WorkItemsApi.GetAccessibleAsync();
            if (result.IsSuccess)
            {
                workItems = result.Value!.Items;
                SelectOnlyCategory();
            }
            else
                loadError = Errors(result);
        }
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        var taskId = IsEdit ? currentTaskId : form.WorkItemId;
        if (taskId is not Guid id || form.Hours is not decimal hours) return;
        isSubmitting = true;
        submitError = null;
        // DateTime.Today is local browser time and would be sent with a UTC offset, which the
        // server converts to the previous day. Send a plain calendar date instead.
        var date = DateTime.SpecifyKind(form.Date.Date, DateTimeKind.Unspecified);
        var result = IsEdit
            ? await TimeEntriesApi.UpdateAsync(EntryId!.Value, new UpdateTimeEntryRequest(date, hours, form.Comment))
            : await TimeEntriesApi.CreateAsync(new CreateTimeEntryRequest(id, date, hours, form.Comment));
        if (result.IsSuccess)
        {
            SaveNotice.Set(IsEdit ? "Ændringerne er gemt." : "Tiden er registreret.");
            Navigation.NavigateTo($"/?date={date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}");
        }
        else
            submitError = Errors(result);
        isSubmitting = false;
    }

    private static string Errors<T>(ApiResult<T> result) => string.Join(" ", result.Errors.Select(item => item.Message));

    private sealed class TimeEntryForm
    {
        // Only used to narrow the work item list; the time entry is registered on the work item.
        public Guid? CategoryId { get; set; }
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Vælg en opgave.")]
        public Guid? WorkItemId { get; set; }
        [System.ComponentModel.DataAnnotations.Range(0.25, 24, ErrorMessage = "Timer skal være mellem 0,25 og 24.")]
        public decimal? Hours { get; set; } = 1m;
        public DateTime Date { get; set; } = DateTime.Today;
        [System.ComponentModel.DataAnnotations.MaxLength(500)]
        public string? Comment { get; set; }
    }
}
