@page "/register-time"
@page "/register-time/{EntryId:guid}"
@using System.Globalization
@inject OrdersApiClient OrdersApiClient
@inject TasksApiClient TasksApiClient
@inject ITimeEntriesApiClient TimeEntriesApiClient
@inject NavigationManager Navigation

<PageTitle>OrdreFlow</PageTitle>

<div class="register-card">
    <div class="register-header">
        <a class="back-btn" href="" aria-label="Tilbage til forsiden">
            <span aria-hidden="true">&lsaquo;</span>
        </a>
        <h1>@(IsEdit ? "Rediger registrering" : "Registrer ny tid")</h1>
    </div>

    @if (isLoading)
    {
        <p class="register-message">Henter oplysninger...</p>
    }
    else if (loadError is not null)
    {
        <p class="validation-message" role="alert">@loadError</p>
        <button type="button" class="btn btn-outline-primary" @onclick="LoadAsync">Prøv igen</button>
    }
    else
    {
        <EditForm Model="formModel" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            @if (IsEdit)
            {
                <div class="form-field">
                    <span class="d-block fw-semibold">Sag</span>
                    <p>@SelectedOrder?.Name</p>
                </div>
                <div class="form-field">
                    <span class="d-block fw-semibold">Opgave</span>
                    <p>@existingTask?.Title</p>
                </div>
            }
            else
            {
                <div class="form-field">
                    <label for="order">Sag</label>
                    <InputSelect id="order" class="form-select form-select-lg"
                                 @bind-Value="formModel.OrderId" @bind-Value:after="OnOrderChanged">
                        <option value="">Vælg sag</option>
                        @foreach (var order in orders?.Where(order =>
                            string.Equals(order.Status, "Open", StringComparison.OrdinalIgnoreCase)) ?? [])
                        {
                            <option value="@order.Id">@order.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => formModel.OrderId" />
                    @if (orders?.Any(order => string.Equals(order.Status, "Open", StringComparison.OrdinalIgnoreCase)) != true)
                    {
                        <p class="register-message">Der er ingen sager tilgængelige.</p>
                    }
                </div>

                <div class="form-field">
                    <label for="task">Opgave</label>
                    <InputSelect id="task" class="form-select form-select-lg"
                                 disabled="@(formModel.OrderId is null || isLoadingTasks || tasksError is not null)"
                                 @bind-Value="formModel.TaskId">
                        <option value="">@(isLoadingTasks ? "Henter opgaver..." : "Vælg opgave")</option>
                        @foreach (var task in tasks)
                        {
                            <option value="@task.Id">@task.Title</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => formModel.TaskId" />
                    @if (tasksError is not null)
                    {
                        <p class="validation-message" role="alert">@tasksError</p>
                        <button type="button" class="btn btn-outline-primary" @onclick="OnOrderChanged">Prøv igen</button>
                    }
                    else if (formModel.OrderId is not null && !isLoadingTasks && tasks.Count == 0)
                    {
                        <p class="register-message">Der er ingen opgaver på denne sag.</p>
                    }
                </div>
            }

            <div class="form-row">
                <div class="form-field">
                    <label for="date">Dato</label>
                    <InputDate id="date" class="form-control form-control-lg" @bind-Value="formModel.Date" />
                    <ValidationMessage For="() => formModel.Date" />
                </div>

                <div class="form-field">
                    <label for="hours">Varighed (timer)</label>
                    <InputNumber id="hours" class="form-control form-control-lg" step="0.25"
                                 inputmode="decimal" placeholder="0,0" @bind-Value="formModel.Hours" />
                    <ValidationMessage For="() => formModel.Hours" />
                </div>
            </div>

            <div class="form-field">
                <label for="comment">Kommentar (valgfri)</label>
                <InputTextArea id="comment" class="form-control" rows="3" @bind-Value="formModel.Comment" />
                <ValidationMessage For="() => formModel.Comment" />
            </div>

            @* Appendices are not part of this milestone (M2); the controls are shown but disabled. *@
            <fieldset class="appendices" disabled>
                <legend>Bilag</legend>
                <button type="button" class="btn btn-outline-secondary w-100">+ Tilføj bilag</button>
                <select class="form-select" aria-label="Bilag">
                    <option>Ingen bilag</option>
                </select>
                <p class="appendices-hint">Bilag kommer i en senere version.</p>
            </fieldset>

            @if (submitError is not null)
            {
                <p class="validation-message" role="alert">@submitError</p>
            }

            <button type="submit" class="btn btn-success submit-btn"
                    disabled="@(isSubmitting || isLoadingTasks || tasksError is not null ||
                                (!IsEdit && orders?.Any(order => string.Equals(order.Status, "Open", StringComparison.OrdinalIgnoreCase)) != true))">
                @(isSubmitting ? "Gemmer..." : IsEdit ? "Gem ændringer" : "Opret")
            </button>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public Guid? EntryId { get; set; }

    [SupplyParameterFromQuery]
    public DateTime? Date { get; set; }

    private TimeRegistrationFormModel formModel = new();
    private IReadOnlyList<OrderResponse>? orders;
    private IReadOnlyList<TaskResponse> tasks = [];
    private TaskResponse? existingTask;
    private bool isLoading = true;
    private bool isLoadingTasks;
    private bool isSubmitting;
    private string? loadError;
    private string? tasksError;
    private string? submitError;

    private bool IsEdit => EntryId is not null;
    private OrderResponse? SelectedOrder => orders?.FirstOrDefault(order => order.Id == formModel.OrderId);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        tasksError = null;
        submitError = null;
        isLoadingTasks = false;
        existingTask = null;
        tasks = [];
        orders = null;
        formModel = new TimeRegistrationFormModel();

        var orderResult = await OrdersApiClient.GetOrdersAsync();
        if (!orderResult.IsSuccess)
        {
            loadError = string.Join(" ", orderResult.Errors.Select(error => error.Message));
            isLoading = false;
            return;
        }

        orders = orderResult.Value!.Items.ToArray();

        if (EntryId is Guid entryId)
        {
            var entryResult = await TimeEntriesApiClient.GetAsync(entryId);
            if (!entryResult.IsSuccess)
            {
                loadError = string.Join(" ", entryResult.Errors.Select(error => error.Message));
                isLoading = false;
                return;
            }

            var entry = entryResult.Value!;
            var taskResult = await TasksApiClient.GetTaskAsync(entry.TaskId);
            if (!taskResult.IsSuccess)
            {
                loadError = string.Join(" ", taskResult.Errors.Select(error => error.Message));
                isLoading = false;
                return;
            }

            existingTask = taskResult.Value!;
            formModel.OrderId = existingTask.OrderId;
            formModel.TaskId = existingTask.Id;
            formModel.Date = entry.Date;
            formModel.Hours = entry.Hours;
            formModel.Comment = entry.Comment;
        }
        else
        {
            formModel.OrderId = null;
            formModel.TaskId = null;
            formModel.Date = Date?.Date ?? DateTime.Today;
            formModel.Hours = null;
            formModel.Comment = null;
        }

        isLoading = false;
    }

    private async Task OnOrderChanged()
    {
        formModel.TaskId = null;
        tasks = [];
        tasksError = null;
        if (formModel.OrderId is not Guid orderId)
        {
            isLoadingTasks = false;
            return;
        }

        isLoadingTasks = true;
        var result = await TasksApiClient.GetTasksAsync(orderId);
        if (formModel.OrderId == orderId)
        {
            if (result.IsSuccess)
            {
                tasks = result.Value!.Items.ToArray();
            }
            else
            {
                tasksError = string.Join(" ", result.Errors.Select(error => error.Message));
            }

            isLoadingTasks = false;
        }
    }

    private async Task Submit()
    {
        if (formModel.Hours is null || formModel.TaskId is not Guid taskId)
        {
            return;
        }

        isSubmitting = true;
        submitError = null;

        var result = EntryId is Guid entryId
            ? await TimeEntriesApiClient.UpdateAsync(entryId,
                new UpdateTimeEntryRequest(formModel.Date, formModel.Hours.Value, formModel.Comment))
            : await TimeEntriesApiClient.CreateAsync(
                new CreateTimeEntryRequest(taskId, formModel.Date, formModel.Hours.Value, formModel.Comment));

        isSubmitting = false;

        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"/?date={formModel.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}");
        }
        else
        {
            submitError = string.Join(" ", result.Errors.Select(error => error.Message));
        }
    }
}
