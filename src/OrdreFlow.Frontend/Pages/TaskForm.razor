@page "/work-planning"
@page "/tasks/new"
@inject WorkPlanningApiClient PlanningApi
@inject DepartmentsApiClient DepartmentsApi
@inject AuthState AuthState
@inject IJSRuntime JS

<PageTitle>@Title | OrdreFlow</PageTitle>

<div class="of-card" id="planning-form">
    <div class="of-card-header">
        <a class="of-back-btn" href="/tasks" aria-label="Tilbage til opgaver">
            <span aria-hidden="true"><NavIcon Name="chevron-left" /></span>
        </a>
        <h1>@Title</h1>
    </div>

    @if (!AuthState.CanPlanWork)
    {
        <p class="alert alert-info">Planlægning er kun tilgængelig for afdelingsledere og administratorer.</p>
    }
    else if (isLoading)
    {
        <p role="status">Henter planlægningsdata...</p>
    }
    else
    {
        @if (IsEditing)
        {
            <div class="edit-banner">
                <span>
                    Du redigerer @(editingCategoryId is not null ? "en kategori" : "en opgave").
                    @if (EditingIsInactive)
                    {
                        <span class="d-block small fw-normal">Den er deaktiveret og kan ikke vælges til tidsregistrering.</span>
                    }
                </span>
                <button type="button" class="btn btn-link p-0" @onclick="CancelEdit">Annuller</button>
            </div>
        }
        else
        {
            <div class="mode-switch" role="tablist" aria-label="Hvad vil du oprette?">
                <button type="button" role="tab" class="mode-btn @(mode == Mode.WorkItem ? "selected" : null)"
                        aria-selected="@(mode == Mode.WorkItem ? "true" : "false")" @onclick="() => SwitchMode(Mode.WorkItem)">Opgave</button>
                <button type="button" role="tab" class="mode-btn @(mode == Mode.Category ? "selected" : null)"
                        aria-selected="@(mode == Mode.Category ? "true" : "false")" @onclick="() => SwitchMode(Mode.Category)">Kategori</button>
            </div>
        }

        @if (error is not null)
        {
            <p class="alert alert-danger" role="alert">@error</p>
        }
        @if (notice is not null)
        {
            <p class="alert alert-success" role="status">@notice</p>
        }

        @if (mode == Mode.Category)
        {
            @if (departments.Count == 0)
            {
                <p class="of-muted">Du har ingen afdelinger, hvor du kan planlægge arbejde.</p>
            }
            else
            {
                <EditForm Model="categoryForm" OnValidSubmit="SaveCategoryAsync">
                    <DataAnnotationsValidator />
                    <div class="form-field">
                        <label for="department">Afdeling</label>
                        <InputSelect id="department" class="form-select form-select-lg" @bind-Value="categoryForm.DepartmentId"
                                     @bind-Value:after="ClearReviewers" disabled="@(editingCategoryId is not null)">
                            <option value="">Vælg afdeling</option>
                            @foreach (var department in departments)
                            {
                                <option value="@department.Id">@department.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => categoryForm.DepartmentId" />
                    </div>
                    <div class="form-field">
                        <label for="category-name">Navn</label>
                        <InputText id="category-name" class="form-control form-control-lg" placeholder="Fx Kundeopgaver"
                                   @bind-Value="categoryForm.Name" />
                        <ValidationMessage For="() => categoryForm.Name" />
                    </div>
                    <div class="form-field">
                        <label for="category-description">Beskrivelse <span class="of-muted">(valgfri)</span></label>
                        <InputTextArea id="category-description" class="form-control" rows="3" @bind-Value="categoryForm.Description" />
                    </div>
                    <div class="form-field assignment-panel">
                        <label for="reviewer">Godkendes af</label>
                        <p class="of-muted small mb-2">De valgte medarbejdere kan godkende og afvise tid i kategorien og får reviewer-rettigheder.</p>
                        @if (categoryForm.DepartmentId.Length == 0)
                        {
                            <p class="of-muted mb-0">Vælg først en afdeling.</p>
                        }
                        else if (AvailableReviewers.Count == 0)
                        {
                            <p class="of-muted mb-0">Afdelingen har ingen aktive medarbejdere.</p>
                        }
                        else
                        {
                            <div class="assignee-picker">
                                <select id="reviewer" class="form-select" @bind="reviewerToAdd">
                                    <option value="">Vælg medarbejder</option>
                                    @foreach (var person in AvailableReviewers.Where(item => !categoryForm.ReviewerIds.Contains(item.EmployeeId)))
                                    {
                                        <option value="@person.EmployeeId">@person.Name@(string.IsNullOrWhiteSpace(person.Title) ? "" : $" · {person.Title}")</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-primary" disabled="@(reviewerToAdd.Length == 0)"
                                        @onclick="AddReviewer">Tilføj</button>
                            </div>
                            @if (categoryForm.ReviewerIds.Count > 0)
                            {
                                <ul class="assignee-chips">
                                    @foreach (var person in AvailableReviewers.Where(item => categoryForm.ReviewerIds.Contains(item.EmployeeId)))
                                    {
                                        <li @key="person.EmployeeId">
                                            <span>@person.Name</span>
                                            <button type="button" aria-label="Fjern @person.Name"
                                                    @onclick="() => categoryForm.ReviewerIds.Remove(person.EmployeeId)">×</button>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                        @if (reviewerError is not null)
                        {
                            <p class="validation-message mt-2 mb-0" role="alert">@reviewerError</p>
                        }
                    </div>
                    <button class="btn btn-primary submit-btn" type="submit" disabled="@isBusy">
                        @(isBusy ? "Gemmer..." : editingCategoryId is not null ? "Gem ændringer" : "Opret kategori")
                    </button>
                </EditForm>
            }
        }
        else if (SelectableCategories.Count == 0)
        {
            <p class="of-muted">
                @(categories.Count == 0
                    ? "Opret først en kategori i en afdeling, du administrerer."
                    : "Alle dine kategorier er deaktiverede. Aktivér en kategori nedenfor, eller opret en ny.")
            </p>
            <button type="button" class="btn btn-outline-primary" @onclick="() => SwitchMode(Mode.Category)">Opret kategori</button>
        }
        else
        {
            <EditForm Model="workForm" OnValidSubmit="SaveWorkItemAsync">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="category">Kategori</label>
                    <InputSelect id="category" class="form-select form-select-lg" @bind-Value="workForm.CategoryId"
                                 @bind-Value:after="ClearAssignees" disabled="@(editingWorkItemId is not null)">
                        <option value="">Vælg kategori</option>
                        @foreach (var group in SelectableCategories.GroupBy(category => category.DepartmentName))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var category in group)
                                {
                                    <option value="@category.Id">@category.Name@(IsActive(category.Status) ? "" : " (deaktiveret)")</option>
                                }
                            </optgroup>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => workForm.CategoryId" />
                </div>
                <div class="form-field">
                    <label for="work-name">Navn</label>
                    <InputText id="work-name" class="form-control form-control-lg" placeholder="Fx Opsæt reoler"
                               @bind-Value="workForm.Name" />
                    <ValidationMessage For="() => workForm.Name" />
                </div>
                <div class="form-field">
                    <span class="field-label">Type</span>
                    <div class="kind-row" role="radiogroup" aria-label="Type">
                        @foreach (var kind in Kinds)
                        {
                            <button type="button" role="radio" class="kind-btn @(workForm.Kind == kind.Value ? "selected" : null)"
                                    aria-checked="@(workForm.Kind == kind.Value ? "true" : "false")"
                                    @onclick="() => workForm.Kind = kind.Value">@kind.Label</button>
                        }
                    </div>
                </div>
                <div class="form-field">
                    <label for="work-description">Beskrivelse <span class="of-muted">(valgfri)</span></label>
                    <InputTextArea id="work-description" class="form-control" rows="3" @bind-Value="workForm.Description" />
                </div>

                <label class="visibility-toggle">
                    <InputCheckbox class="form-check-input" @bind-Value="workForm.AssignmentOnly"
                                   @bind-Value:after="AssignmentOnlyChanged" />
                    <span>
                        <strong>Kun synlig for tildelte medarbejdere</strong>
                        <span class="of-muted d-block">Ellers kan alle i afdelingen se og registrere tid på opgaven.</span>
                    </span>
                </label>

                @if (workForm.AssignmentOnly)
                {
                    <div class="assignment-panel">
                        @if (workForm.CategoryId.Length == 0)
                        {
                            <p class="of-muted mb-0">Vælg først en kategori for at se afdelingens medarbejdere.</p>
                        }
                        else if (AvailableAssignees.Count == 0)
                        {
                            <p class="of-muted mb-0">Afdelingen har ingen aktive medarbejdere at tildele til.</p>
                        }
                        else
                        {
                            <label for="assignee">Tildel medarbejder</label>
                            <div class="assignee-picker">
                                <select id="assignee" class="form-select" @bind="assigneeToAdd">
                                    <option value="">Vælg medarbejder</option>
                                    @foreach (var employee in AvailableAssignees.Where(item => !workForm.AssignedEmployeeIds.Contains(item.EmployeeId)))
                                    {
                                        <option value="@employee.EmployeeId">@employee.Name@(string.IsNullOrWhiteSpace(employee.Title) ? "" : $" · {employee.Title}")</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-primary" disabled="@(assigneeToAdd.Length == 0)"
                                        @onclick="AddAssignee">Tilføj</button>
                            </div>
                            @if (workForm.AssignedEmployeeIds.Count > 0)
                            {
                                <ul class="assignee-chips">
                                    @foreach (var employee in AvailableAssignees.Where(item => workForm.AssignedEmployeeIds.Contains(item.EmployeeId)))
                                    {
                                        <li @key="employee.EmployeeId">
                                            <span>@employee.Name</span>
                                            <button type="button" aria-label="Fjern @employee.Name"
                                                    @onclick="() => workForm.AssignedEmployeeIds.Remove(employee.EmployeeId)">×</button>
                                        </li>
                                    }
                                </ul>
                                <div class="assignment-plan">
                                    <div>
                                        <label for="expected-hours">Forventet tid (timer)</label>
                                        <InputNumber id="expected-hours" class="form-control" min="0.25" step="0.25"
                                                     @bind-Value="workForm.ExpectedHours" />
                                        <ValidationMessage For="() => workForm.ExpectedHours" />
                                    </div>
                                    <div>
                                        <label for="expected-deadline">Deadline</label>
                                        <InputDate id="expected-deadline" class="form-control" @bind-Value="workForm.ExpectedDeadline" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="of-muted mt-2 mb-0">Ingen medarbejdere valgt endnu. Opgaven er kun synlig for dem, du tilføjer.</p>
                            }
                        }
                    </div>
                }

                <button class="btn btn-primary submit-btn" type="submit" disabled="@isBusy">
                    @(isBusy ? "Gemmer..." : editingWorkItemId is not null ? "Gem ændringer" : "Opret opgave")
                </button>
            </EditForm>
        }
    }
</div>

@if (AuthState.CanPlanWork && !isLoading && categories.Count > 0)
{
    <section class="of-card category-overview" aria-labelledby="overview-title">
        <div class="overview-header">
            <div>
                <h2 id="overview-title">Dine kategorier</h2>
                <p class="of-muted mb-0">Tryk på en kategori eller en opgave for at redigere den.</p>
            </div>
        </div>

        <div class="status-filter" role="group" aria-label="Vis kategorier og opgaver">
            @foreach (var option in StatusFilters)
            {
                <button type="button" class="status-filter-btn @(statusFilter == option.Value ? "selected" : null)"
                        aria-pressed="@(statusFilter == option.Value ? "true" : "false")"
                        @onclick="() => statusFilter = option.Value">
                    @option.Label
                    @if (option.Value == StatusFilter.Inactive && InactiveCount > 0)
                    {
                        <span class="filter-count">@InactiveCount</span>
                    }
                </button>
            }
        </div>

        @if (statusMessage is not null)
        {
            <div class="status-message @(statusMessageIsError ? "is-error" : null)" role="@(statusMessageIsError ? "alert" : "status")">
                <span>@statusMessage</span>
                @if (undo is not null)
                {
                    <button type="button" class="btn btn-link p-0" disabled="@(togglingId is not null)" @onclick="UndoAsync">Fortryd</button>
                }
            </div>
        }

        @if (!VisibleCategories.Any())
        {
            <p class="empty-filter">
                @(statusFilter switch
                {
                    StatusFilter.Active => "Du har ingen aktive kategorier. Vælg \"Deaktiverede\" for at genaktivere en kategori.",
                    StatusFilter.Inactive => "Der er ingen deaktiverede kategorier eller opgaver.",
                    _ => "Du har ingen kategorier endnu."
                })
            </p>
        }
        else
        {
            <ul class="order-list">
                @foreach (var (category, items) in VisibleCategories)
                {
                    var categoryActive = IsActive(category.Status);
                    <li @key="category.Id">
                        <div class="order-card category-card @(editingCategoryId == category.Id ? "order-card-selected" : null) @(categoryActive ? null : "is-inactive")">
                            <div class="category-head">
                                <button type="button" class="category-edit-btn" @onclick="() => EditCategory(category)"
                                        aria-label="Rediger kategorien @category.Name">
                                    <span class="order-card-name">
                                        @category.Name
                                        @if (!categoryActive)
                                        {
                                            <span class="status-badge">Deaktiveret</span>
                                        }
                                    </span>
                                    <span class="order-card-customer">@category.DepartmentName · @WorkItemSummary(category)</span>
                                    <span class="order-card-customer">Godkendes af: @ReviewerNames(category)</span>
                                    @if (!categoryActive)
                                    {
                                        <span class="inactive-hint">Kategorien og alle dens opgaver kan ikke vælges til tidsregistrering.</span>
                                    }
                                    <span class="edit-hint">Rediger</span>
                                </button>
                                <button type="button" class="status-toggle @(categoryActive ? null : "activate")"
                                        disabled="@(togglingId is not null)"
                                        aria-label="@(categoryActive ? "Deaktiver" : "Aktivér") kategorien @category.Name"
                                        @onclick="() => SetCategoryActiveAsync(category, !categoryActive)">
                                    @(togglingId == category.Id ? "Gemmer..." : categoryActive ? "Deaktiver" : "Aktivér")
                                </button>
                            </div>
                            @if (items.Count > 0)
                            {
                                <ul class="category-items">
                                    @foreach (var item in items)
                                    {
                                        var itemActive = IsActive(item.Status);
                                        <li @key="item.Id" class="work-item-row @(itemActive ? null : "is-inactive")">
                                            <button type="button" class="work-item-btn @(editingWorkItemId == item.Id ? "selected" : null)"
                                                    @onclick="() => EditWorkItem(category, item)" aria-label="Rediger opgaven @item.Name">
                                                <span class="work-item-name">@item.Name</span>
                                                <span class="kind-tag">@KindLabel(item.Kind)</span>
                                                @if (!itemActive)
                                                {
                                                    <span class="status-badge">Deaktiveret</span>
                                                }
                                                @if (item.AssignmentOnly)
                                                {
                                                    <span class="kind-tag private">Kun tildelte</span>
                                                }
                                                @if (item.Assignments is { Count: > 0 } assigned)
                                                {
                                                    <span class="assignee-count">@AssigneeNames(category, assigned)</span>
                                                }
                                            </button>
                                            <button type="button" class="status-toggle small @(itemActive ? null : "activate")"
                                                    disabled="@(togglingId is not null)"
                                                    title="@(itemActive || categoryActive ? null : "Opgaven bliver først valgbar, når kategorien også er aktiv.")"
                                                    aria-label="@(itemActive ? "Deaktiver" : "Aktivér") opgaven @item.Name"
                                                    @onclick="() => SetWorkItemActiveAsync(category, item, !itemActive)">
                                                @(togglingId == item.Id ? "Gemmer..." : itemActive ? "Deaktiver" : "Aktivér")
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private enum Mode { WorkItem, Category }

    private enum StatusFilter { Active, Inactive, All }

    private static readonly (StatusFilter Value, string Label)[] StatusFilters =
    [
        (StatusFilter.Active, "Aktive"),
        (StatusFilter.Inactive, "Deaktiverede"),
        (StatusFilter.All, "Alle")
    ];

    private StatusFilter statusFilter = StatusFilter.Active;
    private Guid? togglingId;
    private string? statusMessage;
    private bool statusMessageIsError;
    private Func<Task>? undo;

    private static bool IsActive(string status) => string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase);

    // Active view: active categories with their active work. Deactivated view: deactivated categories (with all their
    // work, since none of it can be selected) and deactivated work in active categories.
    private IEnumerable<(PlannableCategoryResponse Category, IReadOnlyList<WorkItemResponse> Items)> VisibleCategories =>
        categories
            .Select(category =>
            {
                var categoryActive = IsActive(category.Status);
                IReadOnlyList<WorkItemResponse> items = statusFilter switch
                {
                    StatusFilter.Active => categoryActive ? category.WorkItems.Where(item => IsActive(item.Status)).ToArray() : [],
                    StatusFilter.Inactive => categoryActive ? category.WorkItems.Where(item => !IsActive(item.Status)).ToArray() : category.WorkItems,
                    _ => category.WorkItems
                };
                var visible = statusFilter switch
                {
                    StatusFilter.Active => categoryActive,
                    StatusFilter.Inactive => !categoryActive || items.Count > 0,
                    _ => true
                };
                return (Category: category, Items: items, Visible: visible);
            })
            .Where(entry => entry.Visible)
            .Select(entry => (entry.Category, entry.Items));

    private int InactiveCount =>
        categories.Count(category => !IsActive(category.Status)) +
        categories.Where(category => IsActive(category.Status)).Sum(category => category.WorkItems.Count(item => !IsActive(item.Status)));

    // New work can only be created in active categories; an item being edited keeps showing its own category.
    private IReadOnlyList<PlannableCategoryResponse> SelectableCategories =>
        categories
            .Where(category => IsActive(category.Status) ||
                               (editingWorkItemId is not null && category.Id.ToString() == workForm.CategoryId))
            .ToArray();

    private bool EditingIsInactive =>
        editingCategoryId is Guid categoryId
            ? categories.FirstOrDefault(item => item.Id == categoryId) is { } category && !IsActive(category.Status)
            : editingWorkItemId is Guid workItemId &&
              categories.SelectMany(item => item.WorkItems).FirstOrDefault(item => item.Id == workItemId) is { } work &&
              !IsActive(work.Status);

    private static string WorkItemSummary(PlannableCategoryResponse category)
    {
        var active = category.WorkItems.Count(item => IsActive(item.Status));
        var inactive = category.WorkItems.Count - active;
        var summary = $"{active} {(active == 1 ? "aktiv opgave" : "aktive opgaver")}";
        return inactive == 0 ? summary : $"{summary} · {inactive} deaktiveret";
    }

    private async Task SetCategoryActiveAsync(PlannableCategoryResponse category, bool active)
    {
        if (togglingId is not null) return;
        togglingId = category.Id;
        var result = await PlanningApi.SetCategoryActiveAsync(category.Id, active);
        togglingId = null;
        if (!result.IsSuccess)
        {
            ShowStatus($"Kategorien \"{category.Name}\" kunne ikke {(active ? "aktiveres" : "deaktiveres")}. {Errors(result)}", isError: true);
            return;
        }

        var status = active ? "Active" : "Closed";
        categories = categories.Select(item => item.Id == category.Id ? item with { Status = status } : item).ToArray();
        ShowStatus(active
                ? $"Kategorien \"{category.Name}\" er aktiveret igen."
                : $"Kategorien \"{category.Name}\" er deaktiveret. Den og dens opgaver kan ikke længere vælges.",
            undoAction: () => SetCategoryActiveAsync(category, !active));
    }

    private async Task SetWorkItemActiveAsync(PlannableCategoryResponse category, WorkItemResponse workItem, bool active)
    {
        if (togglingId is not null) return;
        togglingId = workItem.Id;
        var result = await PlanningApi.SetWorkItemActiveAsync(workItem.Id, active);
        togglingId = null;
        if (!result.IsSuccess)
        {
            ShowStatus($"Opgaven \"{workItem.Name}\" kunne ikke {(active ? "aktiveres" : "deaktiveres")}. {Errors(result)}", isError: true);
            return;
        }

        var status = active ? "Active" : "Closed";
        categories = categories
            .Select(item => item.Id != category.Id
                ? item
                : item with
                {
                    WorkItems = item.WorkItems.Select(work => work.Id == workItem.Id ? work with { Status = status } : work).ToArray()
                })
            .ToArray();
        var categoryActive = categories.FirstOrDefault(item => item.Id == category.Id) is { } current && IsActive(current.Status);
        ShowStatus(active
                ? categoryActive
                    ? $"Opgaven \"{workItem.Name}\" er aktiveret igen."
                    : $"Opgaven \"{workItem.Name}\" er aktiveret, men kan først vælges, når kategorien \"{category.Name}\" også er aktiv."
                : $"Opgaven \"{workItem.Name}\" er deaktiveret og kan ikke længere vælges.",
            undoAction: () => SetWorkItemActiveAsync(category, workItem, !active));
    }

    private void ShowStatus(string message, bool isError = false, Func<Task>? undoAction = null)
    {
        statusMessage = message;
        statusMessageIsError = isError;
        undo = undoAction;
    }

    private async Task UndoAsync()
    {
        var action = undo;
        undo = null;
        if (action is not null)
        {
            await action();
            // The undo itself should not offer to be undone.
            if (!statusMessageIsError) undo = null;
        }
    }

    private static readonly (string Value, string Label)[] Kinds =
    [
        ("Task", "Opgave"),
        ("Project", "Projekt"),
        ("Ticket", "Sag")
    ];

    private Mode mode = Mode.WorkItem;
    private Guid? editingCategoryId;
    private Guid? editingWorkItemId;
    private IReadOnlyList<DepartmentResponse> departments = [];
    private IReadOnlyList<PlannableCategoryResponse> categories = [];
    private CategoryForm categoryForm = new();
    private WorkItemForm workForm = new();
    private string assigneeToAdd = "";
    private string reviewerToAdd = "";
    private string? reviewerError;

    // Managers and members of the chosen department, so a manager can also review the category.
    private IReadOnlyList<DepartmentPersonResponse> AvailableReviewers =>
        departments.FirstOrDefault(item => item.Id.ToString() == categoryForm.DepartmentId) is { } department
            ? department.Managers.Concat(department.Members)
                .Where(person => string.Equals(person.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .DistinctBy(person => person.EmployeeId)
                .OrderBy(person => person.Name)
                .ToArray()
            : [];
    private bool isLoading = true;
    private bool isBusy;
    private string? error;
    private string? notice;

    private bool IsEditing => editingCategoryId is not null || editingWorkItemId is not null;

    private string Title => (mode, IsEditing) switch
    {
        (Mode.Category, true) => "Rediger kategori",
        (Mode.Category, false) => "Ny kategori",
        (_, true) => "Rediger opgave",
        _ => "Ny opgave"
    };

    private IReadOnlyList<DepartmentPersonResponse> AvailableAssignees
    {
        get
        {
            if (!Guid.TryParse(workForm.CategoryId, out var categoryId))
                return [];
            var category = categories.FirstOrDefault(item => item.Id == categoryId);
            return category is null
                ? []
                : departments.FirstOrDefault(item => item.Id == category.DepartmentId)?.Members
                    .Where(employee => string.Equals(employee.Status, "Active", StringComparison.OrdinalIgnoreCase))
                    .OrderBy(employee => employee.Name)
                    .ToArray() ?? [];
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        var departmentResult = await DepartmentsApi.GetDepartmentsAsync();
        var categoryResult = await PlanningApi.GetPlannableCategoriesAsync();
        if (departmentResult.IsSuccess)
            departments = departmentResult.Value!.Items
                .Where(department => department.ManagedByMe || AuthState.IsAdministrator)
                .ToArray();
        if (categoryResult.IsSuccess)
            categories = categoryResult.Value!.Items;
        var messages = departmentResult.Errors.Concat(categoryResult.Errors).Select(item => item.Message).ToArray();
        error = messages.Length == 0 ? null : string.Join(" ", messages);
        isLoading = false;
    }

    private void SwitchMode(Mode next)
    {
        mode = next;
        error = notice = null;
    }

    private async Task EditCategory(PlannableCategoryResponse category)
    {
        editingWorkItemId = null;
        editingCategoryId = category.Id;
        mode = Mode.Category;
        error = notice = null;
        categoryForm = new CategoryForm
        {
            DepartmentId = category.DepartmentId.ToString(),
            Name = category.Name,
            Description = category.Description
        };
        foreach (var reviewerId in category.ReviewerIds ?? [])
            categoryForm.ReviewerIds.Add(reviewerId);
        reviewerToAdd = "";
        reviewerError = null;
        await ScrollToFormAsync();
    }

    private async Task EditWorkItem(PlannableCategoryResponse category, WorkItemResponse item)
    {
        editingCategoryId = null;
        editingWorkItemId = item.Id;
        mode = Mode.WorkItem;
        error = notice = null;
        assigneeToAdd = "";
        var first = item.Assignments?.FirstOrDefault();
        workForm = new WorkItemForm
        {
            CategoryId = category.Id.ToString(),
            Name = item.Name,
            Description = item.Description,
            Kind = item.Kind,
            AssignmentOnly = item.AssignmentOnly || item.Assignments is { Count: > 0 },
            ExpectedHours = first?.ExpectedHours ?? 1m,
            ExpectedDeadline = first?.ExpectedDeadline.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today.AddDays(7)
        };
        foreach (var assignment in item.Assignments ?? [])
            workForm.AssignedEmployeeIds.Add(assignment.EmployeeId);
        await ScrollToFormAsync();
    }

    private void CancelEdit()
    {
        editingCategoryId = editingWorkItemId = null;
        categoryForm = new();
        workForm = new();
        assigneeToAdd = "";
        reviewerToAdd = "";
        reviewerError = null;
        error = notice = null;
    }

    private async Task ScrollToFormAsync()
    {
        try { await JS.InvokeVoidAsync("scrollTo", 0, 0); }
        catch (JSException) { }
    }

    private Task SaveCategoryAsync() =>
        editingCategoryId is Guid id ? UpdateCategoryAsync(id) : CreateCategoryAsync();

    private Task SaveWorkItemAsync() =>
        editingWorkItemId is Guid id ? UpdateWorkItemAsync(id) : CreateWorkItemAsync();

    private async Task UpdateCategoryAsync(Guid categoryId)
    {
        if (!ReviewersAreValid()) return;
        isBusy = true;
        error = notice = null;
        var name = categoryForm.Name.Trim();
        var result = await PlanningApi.UpdateCategoryAsync(categoryId,
            new UpdateCategoryRequest(name, categoryForm.Description, categoryForm.ReviewerIds.ToArray()));
        if (result.IsSuccess)
        {
            CancelEdit();
            notice = $"Kategorien \"{name}\" er opdateret.";
            await LoadAsync();
        }
        else error = Errors(result);
        isBusy = false;
    }

    private async Task UpdateWorkItemAsync(Guid workItemId)
    {
        if (!AssigneesAreValid()) return;
        isBusy = true;
        error = notice = null;
        var name = workForm.Name.Trim();
        var result = await PlanningApi.UpdateWorkItemAsync(workItemId,
            new UpdateWorkItemRequest(name, workForm.Description, workForm.Kind, workForm.AssignmentOnly, Assignments()));
        if (result.IsSuccess)
        {
            CancelEdit();
            notice = $"Opgaven \"{name}\" er opdateret.";
            await LoadAsync();
        }
        else error = Errors(result);
        isBusy = false;
    }

    private bool AssigneesAreValid()
    {
        var available = AvailableAssignees.Select(employee => employee.EmployeeId).ToHashSet();
        if (workForm.AssignedEmployeeIds.All(available.Contains))
            return true;
        error = "Vælg kun medarbejdere, der tilhører den valgte afdeling.";
        return false;
    }

    private CreateWorkItemAssignmentRequest[] Assignments() =>
        workForm.AssignedEmployeeIds
            .Select(id => new CreateWorkItemAssignmentRequest(id, workForm.ExpectedHours, DateOnly.FromDateTime(workForm.ExpectedDeadline)))
            .ToArray();

    private string AssigneeNames(PlannableCategoryResponse category, IReadOnlyList<WorkItemAssignmentResponse> assigned)
    {
        var members = departments.FirstOrDefault(item => item.Id == category.DepartmentId)?.Members ?? [];
        var names = assigned
            .Select(assignment => members.FirstOrDefault(member => member.EmployeeId == assignment.EmployeeId)?.Name ?? "Ukendt")
            .ToArray();
        return names.Length <= 2 ? string.Join(", ", names) : $"{names[0]}, {names[1]} +{names.Length - 2}";
    }

    private async Task CreateCategoryAsync()
    {
        if (!Guid.TryParse(categoryForm.DepartmentId, out var departmentId)) return;
        if (!ReviewersAreValid()) return;
        isBusy = true;
        error = notice = null;
        var result = await PlanningApi.CreateCategoryAsync(departmentId,
            new CreateCategoryRequest(categoryForm.Name.Trim(), Description: categoryForm.Description,
                ReviewerIds: categoryForm.ReviewerIds.ToArray()));
        if (result.IsSuccess)
        {
            notice = $"Kategorien \"{categoryForm.Name.Trim()}\" er oprettet. Du kan nu oprette opgaver i den.";
            categoryForm = new();
            await LoadAsync();
            mode = Mode.WorkItem;
            workForm = new() { CategoryId = result.Value!.Id.ToString() };
        }
        else error = Errors(result);
        isBusy = false;
    }

    private async Task CreateWorkItemAsync()
    {
        if (!Guid.TryParse(workForm.CategoryId, out var categoryId)) return;
        if (!AssigneesAreValid()) return;
        isBusy = true;
        error = notice = null;
        var result = await PlanningApi.CreateWorkItemAsync(categoryId,
            new CreateWorkItemRequest(workForm.Name.Trim(), workForm.Description, workForm.Kind, workForm.AssignmentOnly, Assignments()));
        if (result.IsSuccess)
        {
            notice = $"Opgaven \"{workForm.Name.Trim()}\" er oprettet.";
            workForm = new() { CategoryId = workForm.CategoryId };
            await LoadAsync();
        }
        else error = Errors(result);
        isBusy = false;
    }

    private string ReviewerNames(PlannableCategoryResponse category)
    {
        if (category.ReviewerIds is not { Count: > 0 } ids)
            return "ingen valgt";
        var department = departments.FirstOrDefault(item => item.Id == category.DepartmentId);
        var people = department is null ? [] : department.Managers.Concat(department.Members).ToArray();
        return string.Join(", ", ids.Select(id => people.FirstOrDefault(person => person.EmployeeId == id)?.Name ?? "Ukendt"));
    }

    private bool ReviewersAreValid()
    {
        reviewerError = categoryForm.ReviewerIds.Count == 0
            ? "Vælg mindst én medarbejder, der skal godkende tid i kategorien."
            : null;
        return reviewerError is null;
    }

    private void ClearReviewers()
    {
        categoryForm.ReviewerIds.Clear();
        reviewerToAdd = "";
    }

    private void AddReviewer()
    {
        if (Guid.TryParse(reviewerToAdd, out var employeeId))
            categoryForm.ReviewerIds.Add(employeeId);
        reviewerToAdd = "";
        reviewerError = null;
    }

    private void ClearAssignees()
    {
        workForm.AssignedEmployeeIds.Clear();
        assigneeToAdd = "";
    }

    private void AssignmentOnlyChanged()
    {
        if (!workForm.AssignmentOnly)
            ClearAssignees();
    }

    private void AddAssignee()
    {
        if (Guid.TryParse(assigneeToAdd, out var employeeId))
            workForm.AssignedEmployeeIds.Add(employeeId);
        assigneeToAdd = "";
    }

    private static string KindLabel(string kind) => kind switch
    {
        "Project" => "Projekt",
        "Ticket" => "Sag",
        _ => "Opgave"
    };

    private static string Errors<T>(ApiResult<T> result) => string.Join(" ", result.Errors.Select(item => item.Message));

    private sealed class CategoryForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Vælg en afdeling.")]
        public string DepartmentId { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Kategorien skal have et navn.")]
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public HashSet<Guid> ReviewerIds { get; } = [];
    }

    private sealed class WorkItemForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Vælg en kategori.")]
        public string CategoryId { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Opgaven skal have et navn.")]
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string Kind { get; set; } = "Task";
        public bool AssignmentOnly { get; set; }
        public HashSet<Guid> AssignedEmployeeIds { get; } = [];
        [System.ComponentModel.DataAnnotations.Range(0.25, 10000, ErrorMessage = "Angiv mindst 0,25 timer.")]
        public decimal ExpectedHours { get; set; } = 1m;
        public DateTime ExpectedDeadline { get; set; } = DateTime.Today.AddDays(7);
    }
}
