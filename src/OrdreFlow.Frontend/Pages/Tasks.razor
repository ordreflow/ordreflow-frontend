@page "/tasks"
@inject TasksApiClient TasksApiClient
@inject OrdersApiClient OrdersApiClient
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>OrdreFlow</PageTitle>

<div class="tasks-header">
    <div class="tasks-title">
        <a class="of-back-btn" href="orders" aria-label="Tilbage til ordrer">
            <span aria-hidden="true">&lsaquo;</span>
        </a>
        <div>
            <h1>Opgaver</h1>
            @if (SelectedOrder is not null)
            {
                <p class="tasks-subtitle">@SelectedOrder.Name</p>
            }
        </div>
    </div>
    @if (AuthState.IsManagerOrAdmin)
    {
        <a class="btn btn-primary new-task-btn" href="@NewTaskUrl">+ Ny opgave</a>
    }
</div>

@if (isLoading)
{
    <p class="of-muted">Henter opgaver...</p>
}
else if (loadError is not null)
{
    <p class="validation-message" role="alert">@loadError</p>
    <button type="button" class="btn btn-outline-primary" @onclick="LoadAsync">Prøv igen</button>
}
else
{
    <div class="tasks-filter">
        <label for="order-filter">Sag</label>
        <select id="order-filter" class="form-select" @bind="orderFilter">
            <option value="">Alle sager</option>
            @foreach (var order in orders.OrderBy(order => order.Name))
            {
                <option value="@order.Id">@order.Name</option>
            }
        </select>
    </div>

    @if (FilteredTasks.Count == 0)
    {
        <p class="of-muted">@(tasks.Count == 0 ? "Der er ingen opgaver endnu." : "Der er ingen opgaver på denne sag.")</p>
    }
    else
    {
        <p class="tasks-count">@FilteredTasks.Count @(FilteredTasks.Count == 1 ? "opgave" : "opgaver")</p>

        <ul class="task-list">
            @foreach (var task in FilteredTasks)
            {
                <li>
                    <button type="button" class="task-card" @onclick="() => OpenTask(task.Id)">
                        <span class="task-order">@OrderName(task.OrderId)</span>
                        <span class="task-title">@task.Title</span>
                        @if (!string.IsNullOrWhiteSpace(task.Description))
                        {
                            <span class="task-description">@task.Description</span>
                        }
                        <span class="task-chevron" aria-hidden="true">&rsaquo;</span>
                    </button>
                </li>
            }
        </ul>
    }
}

@code {
    // Set by "Gå til opgaver" on the orders page, so the list opens on that order's tasks.
    [SupplyParameterFromQuery]
    public Guid? OrderId { get; set; }

    private IReadOnlyList<TaskResponse> tasks = [];
    private IReadOnlyList<OrderResponse> orders = [];
    private string orderFilter = "";
    private bool isLoading = true;
    private string? loadError;

    private OrderResponse? SelectedOrder =>
        orders.FirstOrDefault(order => order.Id.ToString() == orderFilter);

    // A new task is created on the order currently shown, if any.
    private string NewTaskUrl => orderFilter == "" ? "tasks/new" : $"tasks/new?orderId={orderFilter}";

    private IReadOnlyList<TaskResponse> FilteredTasks =>
        tasks
            .Where(task => orderFilter == "" || task.OrderId.ToString() == orderFilter)
            .OrderBy(task => OrderName(task.OrderId))
            .ThenBy(task => task.Title)
            .ToArray();

    protected override Task OnParametersSetAsync()
    {
        orderFilter = OrderId?.ToString() ?? "";
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;

        var tasksRequest = TasksApiClient.GetTasksAsync();
        var ordersRequest = OrdersApiClient.GetOrdersAsync();
        var taskResult = await tasksRequest;
        var orderResult = await ordersRequest;

        if (!taskResult.IsSuccess)
        {
            loadError = string.Join(" ", taskResult.Errors.Select(error => error.Message));
        }
        else
        {
            tasks = taskResult.Value!.Items.ToArray();
            // Order names are only for display; the list still works if they can't be loaded.
            orders = orderResult.IsSuccess ? orderResult.Value!.Items.ToArray() : [];
        }

        isLoading = false;
    }

    private string OrderName(Guid orderId) =>
        orders.FirstOrDefault(order => order.Id == orderId)?.Name ?? "Ukendt sag";

    private void OpenTask(Guid id) => Navigation.NavigateTo($"tasks/{id:D}");
}
