@page "/work-items"
@page "/tasks"
@inject WorkItemsApiClient WorkItemsApi
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Arbejdsopgaver | OrdreFlow</PageTitle>

<section class="tasks-page">
    <header class="tasks-header">
        <div>
            <p class="eyebrow">Arbejdsplan</p>
            <h1>Arbejdsopgaver</h1>
            <p class="muted">Arbejde, du har adgang til at registrere tid på.</p>
        </div>
        @if (AuthState.CanPlanWork)
        {
            <a class="btn btn-primary" href="/work-planning">Planlæg arbejde</a>
        }
    </header>

    <label for="work-search">Søg arbejde</label>
    <input id="work-search" class="form-control mb-3" type="search" @bind="search" @bind:event="oninput" />
    @if (isLoading)
    {
        <p role="status">Henter arbejdsopgaver...</p>
    }
    else if (error is not null)
    {
        <p class="alert alert-danger" role="alert">@error</p>
        <button class="btn btn-outline-primary" @onclick="LoadAsync">Prøv igen</button>
    }
    else if (workItems.Count == 0)
    {
        <p class="empty-state">Der er ikke noget arbejde tilgængeligt.</p>
    }
    else
    {
        <ul class="task-list">
            @foreach (var work in FilteredWork)
            {
                <li @key="work.Id">
                    <button class="task-card" type="button" @onclick="() => OpenWorkItem(work.Id)">
                        <span class="task-order">@work.DepartmentName · @work.CategoryName</span>
                        <strong class="task-title">@work.Name</strong>
                        <span class="task-description">@work.Kind@(work.AssignedToMe ? " · Tildelt dig" : "")</span>
                        @if (!string.IsNullOrWhiteSpace(work.Description))
                        {
                            <span class="task-description">@work.Description</span>
                        }
                        <span class="task-chevron" aria-hidden="true"><NavIcon Name="chevron-right" /></span>
                    </button>
                </li>
            }
        </ul>
    }
</section>

@code {
    private IReadOnlyList<AccessibleWorkResponse> workItems = [];
    private string search = "";
    private bool isLoading = true;
    private string? error;

    private IEnumerable<AccessibleWorkResponse> FilteredWork =>
        workItems.Where(item =>
            item.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            item.CategoryName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            item.DepartmentName.Contains(search, StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.DepartmentName)
            .ThenBy(item => item.CategoryName)
            .ThenBy(item => item.Name);

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OpenWorkItem(Guid id) => Navigation.NavigateTo($"/work-items/{id:D}");

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;
        var result = await WorkItemsApi.GetAccessibleAsync();
        if (result.IsSuccess)
            workItems = result.Value!.Items;
        else
            error = string.Join(" ", result.Errors.Select(item => item.Message));
        isLoading = false;
    }
}
